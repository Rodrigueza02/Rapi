# Configuracion local de los microservicios
# Copiar a .env y ajustar segun cada computadora.

VITE_APP_NAME=DeliveryFlow

# Destinos del proxy de Vite (backend corriendo en Docker local)
AUTH_PROXY_TARGET=http://localhost:8087
ORDER_PROXY_TARGET=http://localhost:8081
DASHBOARD_PROXY_TARGET=http://localhost:8085

# Destino del proxy WebSocket en desarrollo (dashboard-backend).
# Vite reenvía /ws → ws://localhost:8086/ws con ws: true.
# En producción, Nginx hace este proxy; esta variable no se usa en el build.
WS_PROXY_TARGET=http://localhost:8086

# En desarrollo, si el WebSocket NO pasa por el proxy de Vite, puedes forzar
# la URL directa definiendo VITE_WS_URL. No la defines en producción.
# VITE_WS_URL=ws://localhost:8086/ws
